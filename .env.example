# ──────────────────────────────────────────────────────────────
# 字帖生成器配置文件
# 用法：复制本文件为 .env，按需修改；命令行参数会覆盖这里的值。
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# .env 只在你本机生效，已被 .gitignore 忽略，不会上传。
# ──────────────────────────────────────────────────────────────

# 字体：stkaiti（华文楷体）/ kaiti（楷体）/ wenkai（霞鹜文楷）
#       或 fonts/ 目录里的字体名关键词，如：田英章硬笔楷书简体
ZITIE_FONT=wenkai

# 标题（横排写在第一行、逐字占格居中；留空则不要标题）
ZITIE_TITLE=观沧海·汉曹操

# 排版方向：horizontal 横排（现代，推荐）/ vertical 竖排（传统从右往左）
ZITIE_ORDER=horizontal

# 纸张：A4 / A5 / B5
ZITIE_PAPER=A4

# 格子样式：mizi 米字格 / tian 田字格 / box 方框
ZITIE_GRID_STYLE=mizi

# 格子边长（mm）。设 0 或留空则用自动/默认 15；也可用命令行 --cols/--rows 自动算
ZITIE_CELL=15

# 页边距（mm）
ZITIE_MARGIN=14

# 字占格子的比例（0~1，越大字越大）
ZITIE_CHAR_SCALE=0.85

# 是否同时导出可打印 PDF：true / false（需要安装 Word 或 LibreOffice）
ZITIE_PDF=true

# 输出文件名（也可用命令行 -o 指定）
ZITIE_OUTPUT=字帖.docx

# 自定义字体目录（放你自己的 .ttf；默认是脚本目录下的 fonts/）
# ZITIE_FONTS_DIR=fonts

# LibreOffice 可执行文件路径（自动检测不到时手动指定；Windows 常见值如下）
# ZITIE_SOFFICE=C:\Program Files\LibreOffice\program\soffice.exe
