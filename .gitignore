# 生成的字帖（docx/pdf 由脚本产出，不入库）
*.docx
*.doc
*.pdf
~$*

# 字体：商业/版权字体不随仓库分发。
# 霞鹜文楷（SIL OFL，免费可商用）已随附；其余字体请自行放入 fonts/。
fonts/*
!fonts/README.md
!fonts/LXGWWenKai-Regular.ttf
!fonts/OFL-LXGW-WenKai.txt

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# 本地配置（含本机路径/偏好，不入库；配置模板见 .env.example）
.env

# 笔顺数据（makemeahanzi，约 29MB，首次使用 --bishun 自动下载）与图片缓存
data/graphics.txt
data/graphics.txt.part
data/cache/
